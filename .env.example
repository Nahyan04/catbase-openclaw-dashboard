# OpenClaw Gateway (required, server-side only — NEVER prefix with NEXT_PUBLIC_)
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=        # from ~/.openclaw/openclaw.json → gateway.auth.token

# OpenClaw Workspace (required)
OPENCLAW_WORKSPACE=                # absolute path to ~/.openclaw/workspace on this host

# Stub mode for offline development (set to "1" to use repo fixtures instead of a real OpenClaw)
OPENCLAW_STUB=

# Integrations (optional — app degrades gracefully if absent)
DISCORD_WEBHOOK_URL=
GOOGLE_CALENDAR_CREDENTIALS=
GITHUB_TOKEN=
TWITTER_API_KEY=
TWITTER_LIST_ID=

# Finance — weekly USD spend that triggers the alert banner (default: 50)
SPEND_ALERT_USD_PER_WEEK=
